# Run the whole platform on YOUR machine, reachable by anyone, over a
# Cloudflare quick tunnel. For showing people the product today — not a host.
#
#   cp .env.tunnel.example .env
#
# ── HOW THIS DIFFERS FROM A REAL DEPLOYMENT ───────────────────────────────
#
# Alive only while your machine is on and the tunnel is running, and the
# hostname changes every time you restart it. Uploads live in the container and
# vanish on the next `down`. Payments are simulated. That is all fine for a
# demo and is stated plainly on screen; it is not fine for real customers.
#
# ── WHY ONE TUNNEL AND NOT TWO ────────────────────────────────────────────
#
# Caddy serves the app AND the API on one origin (see docker/Caddyfile), so you
# tunnel port 80 and everything arrives on one hostname. Tunnelling 3000
# instead would expose only the frontend, and every visitor's browser would try
# to reach the API at their OWN localhost:8000 and fail.
#
# One origin also means no CORS configuration at all — the browser never makes
# a cross-origin request.
#
# ── THE ORDER MATTERS ─────────────────────────────────────────────────────
#
# `NEXT_PUBLIC_*` are COMPILED INTO the browser bundle, so the tunnel URL has
# to be known before the frontend is built:
#
#   1. cloudflared tunnel --url http://localhost:80      -> copy the URL
#   2. paste it into the four <TUNNEL-URL> slots below
#   3. docker compose -f docker-compose.yml -f docker-compose.oci.yml build
#   4. docker compose -f docker-compose.yml -f docker-compose.oci.yml up -d
#
# Restarting the tunnel gives a NEW URL and means repeating 2–4.

# ── Identity ──────────────────────────────────────────────────────────────
# staging, not prod: `prod.py` refuses to boot on a simulated payment adapter.
# staging downgrades that to a warning while keeping every security check —
# DEBUG off, secure cookies, and the signing keys below still rejected if short.
ENVIRONMENT=staging
DJANGO_SETTINGS_MODULE=config.settings.staging
DEBUG=false

# ── Secrets: three DISTINCT values, each >= 32 chars ─────────────────────
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Run it three times. These are fatal even in staging: the moment a real person
# signs in, a shipped key would let anyone with this repo forge their session.
SECRET_KEY=<GENERATE-48-CHARS>
JWT_SIGNING_KEY=<GENERATE-48-CHARS>
TICKET_QR_SIGNING_KEY=<GENERATE-48-CHARS>

# ── The tunnel ────────────────────────────────────────────────────────────
# Caddy listens on plain HTTP; Cloudflare terminates TLS at its edge, so there
# is no certificate to obtain and no port to open on your router.
SITE_DOMAIN=:80
ACME_EMAIL=

# `*` because a quick tunnel's hostname is random and changes on every restart.
# Acceptable for a demo behind a URL only you have shared. For anything
# longer-lived, put the actual hostname here instead.
ALLOWED_HOSTS=*

# Paste the tunnel URL (https://something.trycloudflare.com), no trailing slash.
PUBLIC_SITE_URL=<TUNNEL-URL>
CSRF_TRUSTED_ORIGINS=<TUNNEL-URL>
# Empty on purpose: app and API share one origin, so nothing is cross-origin.
CORS_ALLOWED_ORIGINS=

# Cloudflare + Caddy are two hops in front of Django. Without this every
# per-IP rate limit keys on the proxy and becomes one shared bucket.
NUM_PROXIES=2

# ── Database and cache: on your machine, in Docker ───────────────────────
# Named `eventful-db`/`eventful-cache` rather than postgres/redis — see the
# note in docker-compose.oci.yml about the preflight guard.
POSTGRES_USER=eventful
POSTGRES_PASSWORD=demo-password-change-me
POSTGRES_DB=eventful
DATABASE_URL=postgres://eventful:demo-password-change-me@eventful-db:5432/eventful?sslmode=disable
DIRECT_DATABASE_URL=postgres://eventful:demo-password-change-me@eventful-db:5432/eventful?sslmode=disable
CONN_MAX_AGE=60
DISABLE_SERVER_SIDE_CURSORS=false

REDIS_URL=redis://eventful-cache:6379/0
CACHE_BACKEND=redis

# ── Storage: local, and that is a real limitation ────────────────────────
# Uploads go to the container filesystem and are LOST on `docker compose down`.
# Production refuses this outright; staging warns. Fine for a demo — posters
# survive a restart of the app, not a teardown of the volume.
STORAGE_BACKEND=local
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_PUBLIC_BASE_URL=

# ── Payments simulated, email and SMS to the log ─────────────────────────
# The checkout says "Demo mode — this payment is simulated" and still issues
# real tickets with real signed QR codes through the same confirmation path.
PAYMENTS_BACKEND=fake
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Ticket emails print to the worker's log: `docker compose ... logs -f worker`
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10

SMS_PROVIDER=console
SMS_API_KEY=
SMS_API_BASE_URL=
SMS_SENDER_ID=
SMS_DLT_ENTITY_ID=
SMS_DLT_TEMPLATE_ID=
NOTIFICATION_SMS_DLT_TEMPLATE_IDS=

# ── Background work ───────────────────────────────────────────────────────
QUEUE_BACKEND=local
EVENT_BUS_BACKEND=inprocess
CLOUD_TASKS_QUEUE=
CLOUD_TASKS_LOCATION=
CLOUD_TASKS_TARGET_URL=
CLOUD_TASKS_SERVICE_ACCOUNT=
PUBSUB_TOPIC_EVENTS=
INTERNAL_TASK_SECRET=

# ── Gunicorn ──────────────────────────────────────────────────────────────
PORT=8000
WEB_PORT=127.0.0.1:8000
WEB_CONCURRENCY=2
WEB_THREADS=2
WEB_TIMEOUT=60
WEB_GRACEFUL_TIMEOUT=30
GUNICORN_LOG_LEVEL=info
FORWARDED_ALLOW_IPS=*

# ── Business rules ────────────────────────────────────────────────────────
PLATFORM_FEE_PER_TICKET=10
BOOKING_HOLD_MINUTES=10
SETTLEMENT_REFUND_WINDOW_HOURS=48
SETTLEMENT_MAX_ATTEMPTS=5
SETTLEMENT_RETRY_BACKOFF_SECONDS=60
CHECKIN_WINDOW_OPENS_BEFORE_MINUTES=180
CHECKIN_WINDOW_GRACE_AFTER_MINUTES=360

# ── Rate limits ───────────────────────────────────────────────────────────
THROTTLE_ANON=120/min
THROTTLE_USER=600/min
THROTTLE_AUTH=10/min
THROTTLE_OTP=5/hour
THROTTLE_WEBHOOK=600/min
THROTTLE_CHECKIN=1200/min
THROTTLE_UPLOAD=60/hour
THROTTLE_WRITE=120/min
THROTTLE_MAPS=120/min

# ── Notifications ─────────────────────────────────────────────────────────
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BACKOFF_SECONDS=30
NOTIFICATION_EVENT_REMINDER_HOURS_BEFORE=24

# ── Optional, all disable themselves cleanly when blank ──────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=
PUSH_BACKEND=webpush
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_REGION=in
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_RELEASE=
ENABLE_SILK=false
ALLOW_REMOTE_TEST_DATABASE=

# ── Frontend build args ───────────────────────────────────────────────────
# Same tunnel URL. Baked into the bundle at BUILD time — changing it needs
# `docker compose ... build frontend`, not a restart.
NEXT_PUBLIC_API_BASE_URL=<TUNNEL-URL>
NEXT_PUBLIC_SITE_URL=<TUNNEL-URL>
# Blank: with STORAGE_BACKEND=local, uploads are served by the API on the same
# origin, and next.config.mjs already allows that host.
NEXT_PUBLIC_MEDIA_BASE_URL=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
