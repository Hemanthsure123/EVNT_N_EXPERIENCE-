{
  "name": "event-experience-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "mock:api": "node scripts/mock-api.mjs",
    "build": "next build",
    "build:verify": "node scripts/build-verify.mjs",
    "start": "next start",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:all": "npm run lint && npm run lint:css",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "gen:api": "openapi-typescript ${NEXT_PUBLIC_API_BASE_URL:-http://localhost:8000}/api/schema/ -o lib/api/schema.d.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "3.9.0",
    "@radix-ui/react-avatar": "1.1.0",
    "@radix-ui/react-checkbox": "1.1.1",
    "@radix-ui/react-dialog": "1.1.1",
    "@radix-ui/react-label": "2.1.0",
    "@radix-ui/react-popover": "1.1.1",
    "@radix-ui/react-radio-group": "1.2.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "1.1.0",
    "@radix-ui/react-switch": "1.1.1",
    "@radix-ui/react-tabs": "1.1.0",
    "@radix-ui/react-toast": "1.2.1",
    "@radix-ui/react-tooltip": "1.1.2",
    "@radix-ui/react-visually-hidden": "1.1.0",
    "@tanstack/react-query": "5.56.2",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "framer-motion": "11.5.4",
    "lucide-react": "0.441.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.53.0",
    "tailwind-merge": "2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "web-vitals": "4.2.3",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.0",
    "@playwright/test": "1.47.2",
    "@storybook/addon-a11y": "8.3.2",
    "@storybook/addon-essentials": "8.3.2",
    "@storybook/blocks": "8.3.2",
    "@storybook/nextjs": "8.3.2",
    "@storybook/react": "8.3.2",
    "@storybook/test": "8.3.2",
    "@testing-library/jest-dom": "6.5.0",
    "@testing-library/react": "16.0.1",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.5.5",
    "@types/react": "18.3.8",
    "@types/react-dom": "18.3.0",
    "@typescript-eslint/eslint-plugin": "8.6.0",
    "@typescript-eslint/parser": "8.6.0",
    "@vitejs/plugin-react": "4.3.1",
    "@vitest/coverage-v8": "2.1.1",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.15",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-local-rules": "3.0.2",
    "eslint-plugin-storybook": "0.9.0",
    "jsdom": "25.0.1",
    "openapi-typescript": "7.4.1",
    "postcss": "8.4.47",
    "prettier": "3.3.3",
    "prettier-plugin-tailwindcss": "0.6.8",
    "storybook": "8.3.2",
    "stylelint": "16.9.0",
    "stylelint-config-standard": "36.0.1",
    "tailwindcss": "3.4.13",
    "typescript": "5.6.2",
    "vitest": "2.1.1"
  }
}
