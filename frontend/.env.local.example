# Copy to .env.local. Only PUBLIC, client-safe values ever live here — no
# backend secrets reach this app.

# Base URL of the backend REST API (no trailing slash). The typed client and
# the /gen:api type generation both read this.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Razorpay publishable key id (client-safe) — used by the checkout later.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Public site URL (used for canonical URLs, sitemap, OpenGraph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
