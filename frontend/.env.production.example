# =============================================================================
# Eventful frontend — PRODUCTION environment template
# =============================================================================
# Copy to `.env.local` on the build host (or set these in your platform's build
# environment) and fill in every <PLACEHOLDER>.
#
#     cp .env.production.example .env.local && ${EDITOR:-vi} .env.local
#
# CONTAINS NO SECRETS — and cannot. Everything prefixed `NEXT_PUBLIC_` is
# INLINED INTO THE JAVASCRIPT BUNDLE at build time and readable by any visitor.
# That is not a leak, it is the contract: only values that are public by design
# belong here.
#
# `.env.local.example` is the development template and the canonical reference,
# with each variable explained at length. This file stays terse.
# `core/tests/test_env_contract.py` fails if the two declare different sets.
#
# ── VALUES ARE BAKED IN AT BUILD TIME, NOT READ AT RUNTIME ──────────────────
#
# Changing any of these requires a REBUILD, not a restart. A container started
# with a corrected NEXT_PUBLIC_API_BASE_URL still serves the old one, because
# the old one is a string literal inside the compiled JavaScript.
# =============================================================================


##################################################
# API + site URLs  (REQUIRED)
##################################################
# `next build` FAILS without these two in production — deliberately. Left
# unset they used to fall back to localhost, which is silently wrong: the
# build emits a sitemap, canonical tags and OpenGraph URLs pointing at
# localhost, and search engines index them exactly as written.

# Backend REST API origin, no trailing slash.
NEXT_PUBLIC_API_BASE_URL=https://api.<YOUR-DOMAIN>

# This site's own public origin.
NEXT_PUBLIC_SITE_URL=https://<YOUR-DOMAIN>


##################################################
# Payments  (RECOMMENDED)
##################################################
# Razorpay Checkout's PUBLIC key id — client-safe by design. Optional because
# `POST /bookings` returns the key its order was created with and that one
# always wins; set it so a hard refresh on the payment page can still open
# Checkout.
#
# NEVER the Razorpay secret. That signs webhooks and belongs only on the
# backend.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_<YOUR-KEY-ID>


##################################################
# Media host  (REQUIRED when the backend uses bucket storage)
##################################################
# MIRROR THE BACKEND'S `S3_PUBLIC_BASE_URL`. `next/image` refuses to optimise
# any host not on its allow-list, and next.config.mjs builds that list from
# NEXT_PUBLIC_API_BASE_URL and this variable.
#
# Get this wrong and every poster fails — silently, one image at a time, with
# no build error and no server log.
#
# Leave blank ONLY if the backend still serves /media/ itself, which production
# does not: STORAGE_BACKEND=local is refused there.
NEXT_PUBLIC_MEDIA_BASE_URL=https://<CDN-OR-BUCKET-HOST>/<BUCKET-NAME>


##################################################
# Sign-in providers  (NOT BUILT — leave unset)
##################################################
# The Google, Apple and phone buttons render and fail instantly with a sentence
# naming the provider, rather than showing a spinner or a success that did not
# happen. Setting either of these turns them live, and they would then fail
# against a 404 instead of explaining themselves.
#
# Leave both commented until the backend endpoints exist
# (REAL_INTEGRATIONS_AUDIT.md, R1-R3).
# NEXT_PUBLIC_OAUTH_BASE_URL=/api/v1/auth/oauth
# NEXT_PUBLIC_PHONE_AUTH_ENABLED=1


##################################################
# Google Maps  (OPTIONAL)
##################################################
# The Maps JavaScript API key only. It cannot be proxied — the map renders in
# the browser, so the browser needs a key.
#
# RESTRICT IT IN THE GOOGLE CLOUD CONSOLE: HTTP referrer to your domains, and
# API restriction to Maps JavaScript ONLY. That restriction is the only
# protection a browser key can have, since the value itself is in the page
# source by necessity.
#
# Everything else — Places, Geocoding, Directions, Distance Matrix, Photos —
# goes through the backend on the SERVER key and never appears here.
#
# Blank means no interactive map: the event page renders the address and a
# plain directions link, which answers "how do I get there" and costs nothing.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=<GOOGLE-MAPS-BROWSER-KEY>


##################################################
# Sentry  (CREDENTIAL HELD — SDK NOT WIRED YET)
##################################################
# The FRONTEND DSN — a DIFFERENT Sentry project from the backend's. One DSN for
# both merges server and browser errors into a stream where you cannot tell
# which side broke.
#
# NOTHING READS THIS YET: the frontend has no Sentry SDK installed. Setting it
# alone changes nothing — it needs `@sentry/nextjs` and its config files, which
# is real work rather than a config toggle.
#
# A frontend DSN is public by design: an ingest endpoint that can send events
# and read nothing.
NEXT_PUBLIC_SENTRY_DSN=<FRONTEND-SENTRY-DSN>


##################################################
# Deliberately absent
##################################################
# Google Calendar — the OAuth client id and secret live only on the backend.
#   The frontend asks `GET /api/v1/me/integrations/google` and is sent to an
#   authorization URL the backend mints. A client secret here would be inlined
#   into the bundle and readable by every visitor.
#
# Web Push — the frontend asks `GET /api/v1/push/config` for the VAPID public
#   key, so it lives in exactly one place and cannot drift between the apps.
