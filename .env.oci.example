# Single-box deployment on Oracle Cloud Always Free.
#
#   cp .env.oci.example .env      (on the SERVER, never committed)
#
# ── READ THIS FIRST: WHY THIS USES STAGING SETTINGS ───────────────────────
#
# `DJANGO_SETTINGS_MODULE=config.settings.staging`, not `.prod`, and that is a
# deliberate choice rather than a shortcut.
#
# `prod.py` runs the preflight gate with `strict=True`, which REFUSES to boot
# on any fake adapter. Three of those cannot be made real quickly:
#
#   SMS_PROVIDER=console   India's DLT registration takes WEEKS (entity id,
#                          sender id, and a separately approved template per
#                          message type). Nothing you can do today shortens it.
#   PAYMENTS_BACKEND=fake  Needs a Razorpay account with Route enabled.
#   EMAIL_PROVIDER=console Needs a domain with SPF, DKIM and DMARC aligned.
#
# `staging.py` is the same settings with `strict=False`: the fakes become LOUD
# WARNINGS instead of refusals, while every security check stays fatal — DEBUG
# off, TLS cookies, and the three signing keys still rejected if they are short
# or shipped. That is precisely what the file exists for, in its own words:
# "exercising the booking funnel without moving money is exactly what it is
# for".
#
# So this configuration is honest about what it is: the whole platform running
# publicly, with payments simulated and no SMS. The UI says so on the checkout
# screen rather than pretending. When Razorpay, SMTP and DLT are ready, switch
# the four marked lines and move to `config.settings.prod` — nothing else
# changes. DEPLOY_ORACLE.md §12 is that switch.

# ── Identity ──────────────────────────────────────────────────────────────
ENVIRONMENT=staging
DJANGO_SETTINGS_MODULE=config.settings.staging
DEBUG=false

# ── Secrets: THREE DISTINCT VALUES, EACH >= 32 CHARS ─────────────────────
# Generate each separately. Reusing one value across all three means one leak
# is three compromises, and preflight refuses a value it recognises as shipped.
#
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Rotating TICKET_QR_SIGNING_KEY invalidates every unscanned ticket, and
# JWT_SIGNING_KEY signs out every user. Set them once, keep them.
SECRET_KEY=<GENERATE-48-CHARS>
JWT_SIGNING_KEY=<GENERATE-48-CHARS>
TICKET_QR_SIGNING_KEY=<GENERATE-48-CHARS>

# ── Your domain ───────────────────────────────────────────────────────────
# ONE origin serves both the app and the API (see docker/Caddyfile), so there
# is no CORS preflight on the booking path. Replace every <YOUR-DOMAIN>.
SITE_DOMAIN=<YOUR-DOMAIN>
ACME_EMAIL=<you@example.com>

ALLOWED_HOSTS=<YOUR-DOMAIN>
PUBLIC_SITE_URL=https://<YOUR-DOMAIN>
CORS_ALLOWED_ORIGINS=https://<YOUR-DOMAIN>
CSRF_TRUSTED_ORIGINS=https://<YOUR-DOMAIN>

# Caddy is the ONE proxy in front of Django. At 0, every per-IP rate limit
# collapses into a single bucket keyed on the proxy's own address — which means
# one abusive client throttles everybody. It must match the real hop count.
NUM_PROXIES=1

# ── Database (this box) ───────────────────────────────────────────────────
# The service is `eventful-db`, NOT `postgres`: preflight refuses a production
# database host of `postgres`/`pgbouncer`/`redis`/`db`, because those are the
# development override's service names and a prod process silently talking to
# the dev containers was the worst bug the readiness audit found.
POSTGRES_USER=eventful
POSTGRES_PASSWORD=<GENERATE-32-CHARS>
POSTGRES_DB=eventful

DATABASE_URL=postgres://eventful:<SAME-PASSWORD>@eventful-db:5432/eventful?sslmode=disable
# No pooler on this box, so both URLs are the same connection. DIRECT is what
# migrations and admin tooling use; keeping the variable means moving to a
# pooled Supabase later is a two-line change rather than a code change.
DIRECT_DATABASE_URL=postgres://eventful:<SAME-PASSWORD>@eventful-db:5432/eventful?sslmode=disable

# Persistent connections are safe here BECAUSE there is no transaction pooler
# in front. Behind Supabase's Supavisor both of these must go back to 0/true.
CONN_MAX_AGE=60
DISABLE_SERVER_SIDE_CURSORS=false

# ── Cache (this box) ──────────────────────────────────────────────────────
# `redis://` and not `rediss://`: this never leaves the Docker network. A
# managed Upstash endpoint would be `rediss://` and needs no other change.
REDIS_URL=redis://eventful-cache:6379/0
CACHE_BACKEND=redis

# ── Storage: OCI Object Storage over its S3-compatible API ────────────────
# `local` is REFUSED even in staging's spirit — uploads would land on the
# container filesystem and vanish on the next deploy, taking every event
# poster with them. OCI Object Storage is in the Always Free tier (10 GB) and
# speaks S3. DEPLOY_ORACLE.md §6 creates the bucket and the signing key.
STORAGE_BACKEND=s3
S3_BUCKET_NAME=<BUCKET-NAME>
S3_ENDPOINT_URL=https://<NAMESPACE>.compat.objectstorage.<REGION>.oraclecloud.com
S3_ACCESS_KEY_ID=<CUSTOMER-SECRET-KEY-ACCESS-KEY>
S3_SECRET_ACCESS_KEY=<CUSTOMER-SECRET-KEY-SECRET>
S3_REGION=<REGION>
# The public read URL for the bucket. MUST match NEXT_PUBLIC_MEDIA_BASE_URL
# below, or next/image refuses every poster — silently, one image at a time.
S3_PUBLIC_BASE_URL=https://objectstorage.<REGION>.oraclecloud.com/n/<NAMESPACE>/b/<BUCKET-NAME>/o

# ── Payments: SIMULATED until Razorpay is live ────────────────────────────
# The checkout says "Demo mode — this payment is simulated" and issues real
# tickets with real signed QR codes through the same confirmation path a live
# payment takes. It never pretends money moved.
# TO GO LIVE: set razorpay + the three credentials, then move to prod settings.
PAYMENTS_BACKEND=fake
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Email: console until SMTP is ready ────────────────────────────────────
# Tickets are still ISSUED; the email is printed to the container log instead
# of sent. `docker compose logs -f worker` is where it lands.
# TO GO LIVE: EMAIL_PROVIDER=smtp plus SMTP_HOST and SMTP_FROM_EMAIL.
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10

# ── SMS: console until DLT completes (weeks) ──────────────────────────────
SMS_PROVIDER=console
SMS_API_KEY=
SMS_API_BASE_URL=
SMS_SENDER_ID=
SMS_DLT_ENTITY_ID=
SMS_DLT_TEMPLATE_ID=
NOTIFICATION_SMS_DLT_TEMPLATE_IDS=

# ── Background work ───────────────────────────────────────────────────────
# `local` is a COMPLETE topology: the deployed `worker` process executes the
# tasks. The cloud queue is for cross-service dispatch that does not exist here.
QUEUE_BACKEND=local
EVENT_BUS_BACKEND=inprocess
CLOUD_TASKS_QUEUE=
CLOUD_TASKS_LOCATION=
CLOUD_TASKS_TARGET_URL=
CLOUD_TASKS_SERVICE_ACCOUNT=
PUBSUB_TOPIC_EVENTS=
INTERNAL_TASK_SECRET=

# ── Gunicorn ──────────────────────────────────────────────────────────────
# Bounded by the DATABASE POOL, not the CPU: each worker holds its own
# connections, and exhausting Postgres presents as an outage, not as slowness.
# 3 is comfortable for a 4-OCPU / 24 GB Ampere box against a local Postgres.
PORT=8000
# LOOPBACK ONLY. Caddy talks to gunicorn over the compose network and does not
# need a published port; binding to 127.0.0.1 means the plaintext HTTP port is
# unreachable from the internet even if the firewall is later widened, while
# still being reachable over an SSH tunnel for a management command.
# Dropping the `127.0.0.1:` prefix would expose it on every interface.
WEB_PORT=127.0.0.1:8000
WEB_CONCURRENCY=3
WEB_THREADS=2
WEB_TIMEOUT=60
WEB_GRACEFUL_TIMEOUT=30
GUNICORN_LOG_LEVEL=info
# Caddy is the only thing that talks to gunicorn, over the compose network.
FORWARDED_ALLOW_IPS=*

# ── Business rules: REVIEW THESE, do not accept them ──────────────────────
PLATFORM_FEE_PER_TICKET=10
BOOKING_HOLD_MINUTES=10
SETTLEMENT_REFUND_WINDOW_HOURS=48
SETTLEMENT_MAX_ATTEMPTS=5
SETTLEMENT_RETRY_BACKOFF_SECONDS=60
CHECKIN_WINDOW_OPENS_BEFORE_MINUTES=180
CHECKIN_WINDOW_GRACE_AFTER_MINUTES=360

# ── Rate limits ───────────────────────────────────────────────────────────
THROTTLE_ANON=120/min
THROTTLE_USER=600/min
THROTTLE_AUTH=10/min
THROTTLE_OTP=5/hour
THROTTLE_WEBHOOK=600/min
THROTTLE_CHECKIN=1200/min
THROTTLE_UPLOAD=60/hour
THROTTLE_WRITE=120/min
THROTTLE_MAPS=120/min

# ── Notifications ─────────────────────────────────────────────────────────
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BACKOFF_SECONDS=30
NOTIFICATION_EVENT_REMINDER_HOURS_BEFORE=24

# ── Optional. Absent is a legitimate choice; each disables itself cleanly ──
# Web Push: `manage.py generate_vapid_keys` (self-generated, no vendor).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=
PUSH_BACKEND=webpush

# Maps. Without it the venue picker degrades to plain text fields and the
# public page renders no map — refuse rather than pretend.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_REGION=in

# Google sign-in. The button is hidden entirely when unset.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Google needs BOTH of these registered verbatim as Authorized redirect URIs
# on the SAME OAuth client. Google issues one client per application; a client
# may hold many redirect URIs. They are different callbacks because they do
# different things — sign-in mints a session, calendar stores a grant.
GOOGLE_OAUTH_REDIRECT_URI=https://<YOUR-DOMAIN>/api/v1/auth/oauth/google/callback
GOOGLE_OAUTH_SIGNIN_REDIRECT_URI=https://<YOUR-DOMAIN>/api/v1/auth/oauth/google/signin/callback

# Error reporting.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_RELEASE=

ENABLE_SILK=false
ALLOW_REMOTE_TEST_DATABASE=

# ── Frontend build args ───────────────────────────────────────────────────
# INLINED INTO THE BROWSER BUNDLE at build time. Changing any of these needs
#   docker compose ... build frontend
# A restart does nothing — the old value is already compiled into the JS.
NEXT_PUBLIC_API_BASE_URL=https://<YOUR-DOMAIN>
NEXT_PUBLIC_SITE_URL=https://<YOUR-DOMAIN>
NEXT_PUBLIC_MEDIA_BASE_URL=https://objectstorage.<REGION>.oraclecloud.com/n/<NAMESPACE>/b/<BUCKET-NAME>/o
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
