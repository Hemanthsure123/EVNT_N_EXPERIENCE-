# --- Python / Django ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
/env/
.env
# Any other real env variant (.env.local, .env.production, ...) is a live
# secret and must never be committable; the *.example templates are the one
# committed exception.
.env.*
!.env*.example
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
# Anchored to Django's actual STATIC_ROOT/MEDIA_ROOT — an unanchored
# `media/` would silently drop any future source directory named media.
backend/staticfiles/
backend/media/
*.sqlite3
backend/**/migrations/**/*.pyc

# --- Secrets (never commit) ---
secrets/*.json
!secrets/.gitkeep
*.pem
*.key
# certs*/ not certs/: a Windows path slip once created `certs;C/` beside it,
# and a leaf certificate landing there must be just as unignorable.
docker/dev-tls/certs*/

# --- Node / Next.js (frontend, added later) ---
node_modules/
# Unanchored on purpose: a tool invoked from the repo root writes its output
# HERE, where frontend/.gitignore's anchored rules cannot reach it — that has
# already happened once with test-results/.
.next/
# Alternate Next build outputs (`NEXT_DIST_DIR=…`). A verification build must
# never write into `.next/` while a dev server is holding it — on Windows that
# silently corrupts the running server's output — so these get their own
# directories, and they are build artefacts exactly as `.next/` is.
.next-*/
frontend/out/
frontend/.env.local
test-results/
playwright-report/
blob-report/
playwright/.cache/
storybook-static/
coverage/

# --- Local scratch (tooling passes leave these at the root) ---
/scratch_vars.json

# --- Editors / OS ---
.vscode/
.idea/
.claude/settings.local.json
.DS_Store
Thumbs.db
desktop.ini

# --- Docker volumes / local data ---
.docker-data/

# Environment backups. `.env` itself is ignored above, but a copy made during
# an upgrade is not covered by that pattern and WILL be picked up by
# `git add .` — which is how a live Razorpay secret reaches a public remote.
.env.backup*
.env.*.bak
*.env.backup

# Local backups of tracked config. `.env.*.bak` above covers the dangerous
# case; this is the general one — a backup is a working-tree convenience and
# never a repository file. `docker-compose.override.yml.bak` reached the index
# through `git add -A` and would have shipped a second, stale override.
*.bak
*.orig

# Throwaway browser probes written while debugging a page (Playwright one-offs).
# Not application code, and not something a checkout should carry.
_*probe*.mjs
