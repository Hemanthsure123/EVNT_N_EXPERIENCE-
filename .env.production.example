# =============================================================================
# Eventful — PRODUCTION environment template
# =============================================================================
# Copy to `.env` ON THE PRODUCTION HOST and fill in every <PLACEHOLDER>.
#
#     cp .env.production.example .env && ${EDITOR:-vi} .env
#
# CONTAINS NO SECRETS. Every credential below is a placeholder. If a real value
# ever appears in this file, it is a leak — the file is committed.
#
# ── HOW THIS FILE RELATES TO THE OTHERS ─────────────────────────────────────
#
#   .env.example              development template AND the canonical reference.
#                             Every variable is explained there at length; this
#                             file stays terse on purpose.
#   .env.staging.example      staging.
#   .env.production.example   this file.
#   ENVIRONMENT_VARIABLES.md  the full table: required, default, consumer.
#   DEPLOYMENT.md             the ordered runbook that fills these in.
#
# All four declare the SAME variable set. `core/tests/test_env_contract.py`
# fails if they drift, so a variable added to one must be added to all.
#
# ── WHAT REFUSES TO BOOT ────────────────────────────────────────────────────
#
# `config/settings/prod.py` runs `core.preflight.check_production_settings`,
# which RAISES rather than warns. It refuses: a placeholder or short secret,
# DEBUG=true, empty ALLOWED_HOSTS, CORS_ALLOW_ALL_ORIGINS, ENABLE_SILK, any
# fake adapter, a real adapter missing credentials, a selected backend whose
# SDK is not installed, and any localhost or plain-http public URL.
#
# So a half-filled copy of this file does not start a broken platform — it
# does not start at all, and it prints every problem at once.
# =============================================================================


##################################################
# Django core
##################################################
ENVIRONMENT=production
DJANGO_SETTINGS_MODULE=config.settings.prod
DEBUG=false

# Generate three DISTINCT values, each >= 32 bytes:
#     python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=<GENERATE-64-BYTE-RANDOM-STRING>

# The public hostname(s) this API answers on. No scheme, no port, no wildcard.
ALLOWED_HOSTS=api.<YOUR-DOMAIN>

# The profiler records request bodies — passwords and payment payloads — and
# serves them unauthenticated. Preflight refuses `true` here.
ENABLE_SILK=false


##################################################
# Database — Supabase (ap-south-1 for India)
##################################################
# TWO URLs, deliberately. Supabase project settings -> Database -> Connection
# string. The pooler username is `postgres.<project-ref>`, NOT `postgres`.
#
# Do NOT use db.<project-ref>.supabase.co — it is IPv6-only and most container
# hosts have no IPv6 route. Use the pooler hostname shown in the dashboard.

# Runtime. Supavisor TRANSACTION mode, port 6543.
DATABASE_URL=postgresql://postgres.<PROJECT-REF>:<DB-PASSWORD>@aws-1-<REGION>.pooler.supabase.com:6543/postgres?sslmode=require

# Migrations, manage.py and any DDL. Supavisor SESSION mode, port 5432.
# DDL through a transaction pooler is unreliable, which is why this is separate.
DIRECT_DATABASE_URL=postgresql://postgres.<PROJECT-REF>:<DB-PASSWORD>@aws-1-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require

# Both REQUIRED behind a transaction pooler: it manages connection reuse
# itself, and server-side cursors need session affinity it does not provide.
CONN_MAX_AGE=0
DISABLE_SERVER_SIDE_CURSORS=true


##################################################
# Redis — Upstash
##################################################
# Drop `?ssl_cert_reqs=none`. That parameter exists only for the self-signed
# certificate in local development; Upstash's is CA-signed, and keeping it
# disables certificate verification in production.
REDIS_URL=rediss://default:<UPSTASH-TOKEN>@<ENDPOINT>.upstash.io:6379
CACHE_BACKEND=redis


##################################################
# Authentication
##################################################
# A DIFFERENT random value from SECRET_KEY. With this key, anyone holding it
# can mint a valid session for any user id — including a staff one.
JWT_SIGNING_KEY=<GENERATE-64-BYTE-RANDOM-STRING>
ACCESS_TOKEN_LIFETIME_MIN=30
REFRESH_TOKEN_LIFETIME_DAYS=14


##################################################
# Payments — Razorpay
##################################################
# Dashboard -> Settings -> API Keys. Route must be ENABLED on the account, or
# the organizer share cannot be transferred on hold and the platform ends up
# holding organizer funds.
RAZORPAY_KEY_ID=rzp_live_<YOUR-KEY-ID>
RAZORPAY_KEY_SECRET=<YOUR-KEY-SECRET>

# Dashboard -> Settings -> Webhooks. Register
#   https://api.<YOUR-DOMAIN>/api/v1/payments/webhook
# for `payment.captured` and `payment.failed`, and paste its secret here.
# THE SIGNED WEBHOOK IS THE ONLY PROOF OF PAYMENT — the browser redirect is not.
RAZORPAY_WEBHOOK_SECRET=<WEBHOOK-SIGNING-SECRET>

PAYMENTS_BACKEND=razorpay

# Development ONLY — the docker-compose dev override reads this to pick its
# PaymentPort. It has NO effect here: staging and production read
# PAYMENTS_BACKEND above. Declared (commented) for the same reason
# DEV_EMAIL_PROVIDER is: every template holds the same variable set, which is
# what stops one file silently omitting a value nobody chose.
# DEV_PAYMENTS_BACKEND=fake


##################################################
# Email — SMTP
##################################################
# Use a domain you control, with SPF + DKIM + DMARC aligned. Ticket delivery is
# the most important message this platform sends.
#
# Gmail works for launch and preflight warns about it: ~500 recipients/day, and
# Gmail rewrites the From header so SPF/DKIM cannot align to your own domain.
EMAIL_PROVIDER=smtp

# Development ONLY — the docker-compose dev override reads this to pick its
# EmailPort. It has NO effect here: staging and production read EMAIL_PROVIDER
# above. Declared (commented) so every template holds the same variable set,
# which is what stops one file silently omitting a value nobody chose.
# DEV_EMAIL_PROVIDER=console
SMTP_HOST=<SMTP-HOSTNAME>
SMTP_PORT=587
SMTP_USERNAME=<SMTP-USERNAME>
SMTP_PASSWORD=<SMTP-PASSWORD-OR-APP-PASSWORD>
SMTP_FROM_EMAIL=tickets@<YOUR-DOMAIN>
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10


##################################################
# Object storage — S3-compatible
##################################################
# `local` is REFUSED in production: uploads would go to the container
# filesystem and vanish on the next deploy.
#
# One adapter covers Supabase Storage, Cloudflare R2, Backblaze B2, MinIO and
# AWS S3 — they speak the same protocol, so switching provider is a URL change.
STORAGE_BACKEND=s3

S3_BUCKET_NAME=<BUCKET-NAME>
# Supabase: https://<PROJECT-REF>.supabase.co/storage/v1/s3
# R2:       https://<ACCOUNT-ID>.r2.cloudflarestorage.com
# Blank means real AWS S3.
S3_ENDPOINT_URL=https://<PROJECT-REF>.supabase.co/storage/v1/s3
# Supabase: Storage -> S3 Access Keys -> New access key.
# NOT the anon key and NOT the service-role key.
S3_ACCESS_KEY_ID=<S3-ACCESS-KEY-ID>
S3_SECRET_ACCESS_KEY=<S3-SECRET-ACCESS-KEY>
S3_REGION=<REGION>
# What browsers fetch objects from — a CDN in front of the bucket, ideally.
# THIS HOST MUST ALSO BE `NEXT_PUBLIC_MEDIA_BASE_URL` in the frontend, or
# next/image refuses every poster, silently, one image at a time.
S3_PUBLIC_BASE_URL=https://<CDN-OR-BUCKET-HOST>/<BUCKET-NAME>

# Google Cloud Storage — unused. The `gcp` extra is NOT in the production
# image (see INSTALL_EXTRAS in backend/Dockerfile), so selecting a GCS backend
# without rebuilding is refused at boot rather than failing on first upload.
GCS_BUCKET_NAME=
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=


##################################################
# Background work
##################################################
# `local` runs a task inline in the process that enqueued it, and the deployed
# `worker` service is what executes them. That is a complete, supported
# topology — cloud_tasks is only needed for cross-service dispatch.
QUEUE_BACKEND=local
EVENT_BUS_BACKEND=inprocess

# Only when QUEUE_BACKEND=cloud_tasks. Preflight refuses a blank target URL or
# secret in that case, because an unauthenticated dispatch endpoint is a URL
# anyone can use to trigger a payout release.
CLOUD_TASKS_QUEUE=
CLOUD_TASKS_LOCATION=
CLOUD_TASKS_TARGET_URL=
CLOUD_TASKS_SERVICE_ACCOUNT=

# Only when EVENT_BUS_BACKEND=pubsub.
PUBSUB_TOPIC_EVENTS=

# A blank INTERNAL_TASK_SECRET makes /internal/tasks/run answer 503 — it fails
# closed, never open. Required only with QUEUE_BACKEND=cloud_tasks.
INTERNAL_TASK_SECRET=


##################################################
# Notifications
##################################################
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BACKOFF_SECONDS=30
NOTIFICATION_EVENT_REMINDER_HOURS_BEFORE=24

# The timezone every human-readable date in an outbound message is rendered in.
# SEPARATE from the database's UTC: one is how an instant is stored, the other
# is how a person reads it. The ticket PDF somebody carries to a gate must say
# the same time as the event page they bought it from.
NOTIFICATION_DISPLAY_TIMEZONE=Asia/Kolkata

# Where "something is waiting for your decision" alerts go — an event submitted
# for review, an organization asking to be verified, a performer profile in the
# queue. Comma-separated; a shared ops mailbox and three named people are both
# fine.
#
# SET THIS IN PRODUCTION. Empty is a valid configuration and sends NO alert —
# submissions still succeed and the skip is logged, so the failure is silent
# from the organiser's side: they see "pending review" and no human is ever
# told. There is no safe address to fall back on, which is why it cannot
# default to one.
PLATFORM_ADMIN_EMAILS=<OPS-MAILBOX@YOUR-DOMAIN>


##################################################
# Public URLs
##################################################
# Each of these is followed by somebody else: Google matches the redirect URI
# verbatim, the browser enforces CORS, Django rejects an unlisted Host.
# Preflight refuses any of them left on localhost or plain http.
PUBLIC_SITE_URL=https://<YOUR-DOMAIN>
CORS_ALLOWED_ORIGINS=https://<YOUR-DOMAIN>
CSRF_TRUSTED_ORIGINS=https://api.<YOUR-DOMAIN>

# Hops that PREPEND to X-Forwarded-For. Cloudflare Tunnel -> container is 1.
# Cloudflare -> ALB -> container is 2.
#
# At 0, DRF keys rate limits on the proxy's own address and every IP-keyed
# limit collapses into ONE bucket: THROTTLE_AUTH=10/min becomes ten attempts
# per minute for the entire internet.
NUM_PROXIES=1


##################################################
# Web Push (VAPID)
##################################################
# Self-generated — no vendor, no account:
#     python manage.py generate_vapid_keys
# Left blank, push disables itself honestly: the port reports unconfigured,
# the subscribe endpoint 422s, and the UI renders nothing.
VAPID_PUBLIC_KEY=<VAPID-PUBLIC-KEY>
VAPID_PRIVATE_KEY=<VAPID-PRIVATE-KEY>
VAPID_CONTACT=mailto:ops@<YOUR-DOMAIN>
PUSH_BACKEND=webpush


##################################################
# Observability — Sentry
##################################################
# Backend DSN. A DIFFERENT project from the frontend's, or server and browser
# errors merge into one stream.
#
# If this is set and `sentry-sdk` is missing, preflight REFUSES to boot: a set
# DSN means somebody expects reporting, and degrading quietly is how a platform
# runs for a month with no alerting and nobody notices.
SENTRY_DSN=<BACKEND-SENTRY-DSN>
SENTRY_TRACES_SAMPLE_RATE=0.1
# Set per deploy (a git SHA) so a stack trace maps to a commit.
SENTRY_RELEASE=<GIT-SHA>


##################################################
# Tickets
##################################################
# A THIRD distinct random value. With this key, anyone can forge a ticket that
# passes the gate scanner.
TICKET_QR_SIGNING_KEY=<GENERATE-64-BYTE-RANDOM-STRING>


##################################################
# Rate limits
##################################################
# Commented out = the code's defaults apply. Uncomment only to override.
# They fail OPEN if Redis is down: a shut door at a venue is worse than a
# window of unmetered requests, and the correctness guards (signature
# verification, row locks) never depended on them.
# THROTTLE_ANON=120/min
# THROTTLE_USER=600/min
# THROTTLE_AUTH=10/min
# THROTTLE_OTP=5/min
# THROTTLE_WEBHOOK=300/min
# THROTTLE_CHECKIN=600/min
# THROTTLE_UPLOAD=30/min
# THROTTLE_WRITE=120/min
# THROTTLE_MAPS=60/min


##################################################
# Business rules — decisions, not defaults to accept
##################################################
# Each of these has money or customer experience attached. Review every one
# before launch rather than shipping the development value.
BOOKING_HOLD_MINUTES=10
# Payment reconciliation (payments.reconcile_pending): the backstop that asks
# the provider whether a booking's order was actually paid, so a captured
# payment is fulfilled — or refunded — even if no webhook and no browser call
# ever arrived. MIN_AGE keeps it from racing the browser's own verify call;
# GRACE bounds how long after a lapsed hold the platform keeps asking.
PAYMENT_RECONCILE_MIN_AGE_SECONDS=90
PAYMENT_RECONCILE_GRACE_MINUTES=180
PLATFORM_FEE_PER_TICKET=2000
SETTLEMENT_REFUND_WINDOW_HOURS=48
SETTLEMENT_MAX_ATTEMPTS=5
SETTLEMENT_RETRY_BACKOFF_SECONDS=300
CHECKIN_WINDOW_OPENS_BEFORE_MINUTES=120
CHECKIN_WINDOW_GRACE_AFTER_MINUTES=120


##################################################
# SMS — India DLT
##################################################
# DLT registration takes WEEKS and must start well before launch: entity
# registration, sender id, and a separately approved template per message type.
#
# Until then `console` is correct and honest — no SMS is sent, and nothing
# pretends otherwise.
SMS_PROVIDER=console
SMS_API_KEY=
SMS_API_BASE_URL=
SMS_SENDER_ID=
SMS_DLT_ENTITY_ID=
SMS_DLT_TEMPLATE_ID=
NOTIFICATION_SMS_DLT_TEMPLATE_IDS=


##################################################
# Google Maps Platform
##################################################
# ONE key, six APIs. Everything except Maps JavaScript is proxied server-side,
# because a browser key is only referrer-restricted and any script can forge a
# referrer — and because Google's photo endpoint takes the key as a QUERY
# PARAMETER, so linking it directly would publish the key in an <img src>.
#
# RESTRICT THE KEY IN THE CONSOLE. That cannot be verified from this
# repository, and an unrestricted key is a billable resource anyone who finds
# it can spend. Set a budget alert too — Maps bills per request with no
# ceiling by default.
GOOGLE_MAPS_API_KEY=<GOOGLE-MAPS-SERVER-KEY>
GOOGLE_MAPS_REGION=in


##################################################
# Google OAuth — Calendar
##################################################
# ONE OAuth client for the whole application. A second would mean a second
# consent screen and a second verification review.
#
# Enable the Google Calendar API on the same project. Scopes requested are
# `calendar.events`, `openid` and `email` — never the broader `calendar`
# scope, which also permits deleting entire calendars.
GOOGLE_OAUTH_CLIENT_ID=<OAUTH-CLIENT-ID>.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=<OAUTH-CLIENT-SECRET>

# Must be registered VERBATIM as an Authorized redirect URI, or Google refuses
# the callback with redirect_uri_mismatch. It points at THIS API, not the
# frontend — the backend completes the exchange and then redirects the browser.
GOOGLE_OAUTH_REDIRECT_URI=https://api.<YOUR-DOMAIN>/api/v1/auth/oauth/google/callback

# Sign-in's own callback. Same OAuth client as calendar (Google issues one per
# application); a client may register many redirect URIs and BOTH must be
# listed verbatim in the console, or Google refuses with redirect_uri_mismatch.
GOOGLE_OAUTH_SIGNIN_REDIRECT_URI=https://api.<YOUR-DOMAIN>/api/v1/auth/oauth/google/signin/callback


##################################################
# Web server (gunicorn)
##################################################
# Read by backend/docker/gunicorn.conf.py, not by Django.
PORT=8000

# BOUNDED BY THE POOLER, not by CPU: each worker holds its own database
# connections, and the scheduler and outbox worker draw from the same Supabase
# client limit. Exhausting it presents as a database outage.
#
# Blank = (2*CPU)+1 capped at 9. An explicit value is honoured, with a warning
# printed on the process's first line if it exceeds the safe ceiling.
WEB_CONCURRENCY=
WEB_THREADS=2
WEB_TIMEOUT=60
# MUST stay below `stop_grace_period` in docker-compose.yml (40s), or Docker
# kills a worker before it finishes — mid-deploy that can land between
# recording a payment and issuing the ticket.
WEB_GRACEFUL_TIMEOUT=30
GUNICORN_LOG_LEVEL=info
# Which peers gunicorn believes X-Forwarded-* from. Deliberately not `*`:
# trusting every peer lets anything that can reach the container forge its
# source IP and assert X-Forwarded-Proto: https, defeating SSL redirect.
# Default (blank) is the private ranges, correct for a tunnel sidecar.
FORWARDED_ALLOW_IPS=


##################################################
# Test safety
##################################################
# LEAVE BLANK IN PRODUCTION. pytest CREATES AND DROPS its database; test
# settings refuse a non-local host, and this is the only override.
ALLOW_REMOTE_TEST_DATABASE=


##################################################
# Deployment topology (docker-compose + Caddy)
##################################################
# Read by the compose files and the reverse proxy rather than by Django. They
# belong in every template because a deploy variable that exists only in one
# environment's private file is one nobody can reproduce the others from --
# the same failure the .env/.env.example parity check exists to catch.

# The public hostname Caddy serves and registers a TLS certificate for.
SITE_DOMAIN=<YOUR-DOMAIN>
ACME_EMAIL=<ops@YOUR-DOMAIN>

# Where Caddy sends non-API traffic, and the port gunicorn binds in-container.
FRONTEND_UPSTREAM=frontend:3000
WEB_PORT=8000

# The BUNDLED Postgres container's own credentials. Distinct from DATABASE_URL,
# which is what the app connects with -- in production that points at a managed
# instance and these go unused.
POSTGRES_USER=app
POSTGRES_PASSWORD=<STRONG-LOCAL-PASSWORD>
POSTGRES_DB=eventsdb

# Frontend build args, passed into the Next.js image build. They are
# NEXT_PUBLIC_, so they are inlined into the browser bundle -- never put a
# secret in one.
NEXT_PUBLIC_API_BASE_URL=https://<YOUR-DOMAIN>
NEXT_PUBLIC_SITE_URL=https://<YOUR-DOMAIN>
NEXT_PUBLIC_MEDIA_BASE_URL=<YOUR-STORAGE-HOST>
NEXT_PUBLIC_RAZORPAY_KEY_ID=<RAZORPAY-KEY-ID>
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=<BROWSER-RESTRICTED-MAPS-KEY>
