# Copy this file to .env for local development.
# Every value here is a dummy / placeholder. NEVER commit real secrets.
# In staging/production these are injected by a secrets manager, not this file.

# --- App / core ---
ENVIRONMENT=development
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=dev-secret-change-me-0000000000000000
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
# Lightweight per-request profiler (django-silk) at /silk/ — off by default
# even in dev; real overhead, switch on deliberately when you need it.
ENABLE_SILK=false

# --- Database (Postgres) ---
# Shape of a real Neon POOLED connection string (transaction-mode pooler —
# note the "-pooler" host suffix and required sslmode). Locally this is
# simulated by the pgbouncer service in docker-compose.yml; see .env for
# the actual value used when running docker-compose or manage.py locally.
# Used for the app's normal runtime queries.
# DATABASE_URL=postgres://neondb_owner:dummy_password@ep-dummy-lake-12345678-pooler.us-east-2.aws.neon.tech/eventsdb?sslmode=require
DATABASE_URL=postgres://app:app@localhost:6432/eventsdb?sslmode=require
# 0 with a transaction-mode pooler (PgBouncer/Neon) — the pooler already
# manages connection reuse, so Django must not also hold long-lived ones.
CONN_MAX_AGE=0
# Required behind a transaction-mode pooler: server-side cursors need
# session affinity that transaction pooling doesn't provide.
DISABLE_SERVER_SIDE_CURSORS=true

# Neon's DIRECT (non-pooled) connection string — same database, host
# without the "-pooler" suffix. Needed for migrations/admin commands and
# the test suite: pytest-django creates a throwaway "test_eventsdb"
# database on the fly, and a transaction-mode pooler's static database list
# (just "eventsdb" here) has no way to route to a database it doesn't know
# about yet. Falls back to DATABASE_URL if unset (e.g. in CI, which talks
# to Postgres directly with no pooler in front of it at all).
# DIRECT_DATABASE_URL=postgres://neondb_owner:dummy_password@ep-dummy-lake-12345678.us-east-2.aws.neon.tech/eventsdb?sslmode=require
DIRECT_DATABASE_URL=postgres://app:app@localhost:5432/eventsdb

# --- Cache / locks (Redis) ---
# Shape of a real Upstash TLS endpoint:
# REDIS_URL=rediss://default:dummy_password@dummy-name-12345.upstash.io:6379
# Locally this is simulated by the redis service's TLS listener (port 6380)
# in docker-compose.yml with a self-signed cert, hence ssl_cert_reqs=none —
# a real Upstash cert is CA-signed, so drop that query param in staging/prod.
REDIS_URL=rediss://localhost:6380/0?ssl_cert_reqs=none

# --- Auth / JWT ---
JWT_SIGNING_KEY=dev-jwt-signing-key-change-me-0000000000
ACCESS_TOKEN_LIFETIME_MIN=15
REFRESH_TOKEN_LIFETIME_DAYS=30

# --- Booking / tickets ---
BOOKING_HOLD_MINUTES=10
TICKET_QR_SIGNING_KEY=dev-qr-signing-key-change-me-000000000000

# --- Check-in (gate scan window, in minutes) ---
CHECKIN_WINDOW_OPENS_BEFORE_MINUTES=180
CHECKIN_WINDOW_GRACE_AFTER_MINUTES=360

# --- Vendor selection (dev = fakes; prod flips these) ---
# CACHE_BACKEND is "redis" (not faked) even in dev — caching is exercised
# for real against the (locally simulated) managed Redis instance.
PAYMENTS_BACKEND=fake
STORAGE_BACKEND=local
QUEUE_BACKEND=local
EVENT_BUS_BACKEND=inprocess
EMAIL_PROVIDER=console
SMS_PROVIDER=console
CACHE_BACKEND=redis

# --- Razorpay (payments + Route split) ---
RAZORPAY_KEY_ID=rzp_test_dummy1234567890
RAZORPAY_KEY_SECRET=dummy_rzp_secret_0000000000000000
RAZORPAY_WEBHOOK_SECRET=dummy_rzp_webhook_secret_00000000
RAZORPAY_ROUTE_ENABLED=true
PLATFORM_FEE_PER_TICKET=10

# --- Google sign-in (OAuth) ---
GOOGLE_OAUTH_CLIENT_ID=dummy-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=dummy-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- Email provider ---
EMAIL_API_KEY=dummy-email-api-key
EMAIL_FROM=tickets@example.com
EMAIL_API_BASE_URL=https://dummy-email-provider.example.com/api

# --- SMS provider (+ India DLT) ---
SMS_API_KEY=dummy-sms-api-key
SMS_SENDER_ID=EVENTS
SMS_DLT_ENTITY_ID=dummy-dlt-entity-id
SMS_DLT_TEMPLATE_ID=dummy-dlt-template-id
SMS_API_BASE_URL=https://dummy-sms-provider.example.com/api

# --- Notifications ---
# Optional per-type DLT template overrides, e.g. "otp=tmpl_otp,booking_confirmation_sms=tmpl_bk"
NOTIFICATION_SMS_DLT_TEMPLATE_IDS=
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BACKOFF_SECONDS=30
NOTIFICATION_EVENT_REMINDER_HOURS_BEFORE=24

# --- Settlements (organizer payout after event + refund window) ---
SETTLEMENT_REFUND_WINDOW_HOURS=48
SETTLEMENT_MAX_ATTEMPTS=5
SETTLEMENT_RETRY_BACKOFF_SECONDS=60

# --- Google Cloud (Storage / Pub-Sub / Tasks / Run) ---
GCP_PROJECT_ID=dummy-project-id
GCS_BUCKET_NAME=dummy-bucket
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-sa-dummy.json
PUBSUB_TOPIC_EVENTS=platform-events
CLOUD_TASKS_QUEUE=default-queue
CLOUD_TASKS_LOCATION=asia-south1

# --- CORS (frontend origins allowed to call the API in staging/prod) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend (later) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_dummy1234567890
