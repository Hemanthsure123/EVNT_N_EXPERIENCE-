# =============================================================================
# Eventful — backend environment
# =============================================================================
# Copy to `.env` for local development. Every value here is a placeholder.
# NEVER commit real secrets; in staging/production these are injected by a
# secrets manager, not by this file.
#
# EVERY variable below is read by code. The full reference — required/optional,
# defaults, consumers — is ENVIRONMENT_VARIABLES.md, which came out of the same
# audit that produced this file and is the single source of truth.
#
# Production refuses to boot on a placeholder (backend/core/preflight.py), so a
# forgotten value fails the deploy rather than silently doing nothing.
# =============================================================================


##################################################
# Django
##################################################
ENVIRONMENT=development
DJANGO_SETTINGS_MODULE=config.settings.dev
DEBUG=true

# Generate: python -c "import secrets;print(secrets.token_urlsafe(64))"
# Production refuses to start on this shipped value.
SECRET_KEY=dev-secret-change-me-0000000000000000

# Comma-separated. Production refuses to start if empty.
ALLOWED_HOSTS=localhost,127.0.0.1

# Per-request profiler (django-silk) at /silk/. OFF by default even in dev —
# it has real overhead, and it records request bodies (passwords, payment
# payloads) and serves them unauthenticated, so production refuses to start
# with it on. Needs the `dev` extra plus a migrate.
ENABLE_SILK=false


##################################################
# Database (Supabase PostgreSQL)
##################################################
# TWO URLs, on purpose. Both from Supabase → Project Settings → Database.
#
#   DATABASE_URL         Supavisor TRANSACTION mode, port 6543. The app's
#                        normal runtime queries.
#   DIRECT_DATABASE_URL  Supavisor SESSION mode, port 5432. Migrations, admin
#                        commands and pytest — a transaction pooler cannot
#                        create or route to the throwaway `test_<db>` database
#                        pytest-django makes on the fly.
#
# Two things catch people out on Supabase:
#   1. The pooler username is `postgres.<project-ref>`, not `postgres`.
#   2. Do NOT use `db.<ref>.supabase.co:5432` for DIRECT_DATABASE_URL — that
#      host is IPv6-only for new projects unless you buy the IPv4 add-on.
#      Supavisor session mode (same pooler host, port 5432) is IPv4-reachable
#      and behaves the same way.
#
# Production shape:
# DATABASE_URL=postgres://postgres.abcdefghijkl:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
# DIRECT_DATABASE_URL=postgres://postgres.abcdefghijkl:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
#
# Local dev uses the PgBouncer + Postgres pair in docker-compose.yml, which
# mirrors Supavisor's transaction/session split so the switch is config-only.
DATABASE_URL=postgres://app:app@localhost:6432/eventsdb?sslmode=require
DIRECT_DATABASE_URL=postgres://app:app@localhost:5432/eventsdb

# Both REQUIRED behind a transaction-mode pooler: the pooler already manages
# connection reuse, and server-side cursors need session affinity that
# transaction pooling does not provide.
CONN_MAX_AGE=0
DISABLE_SERVER_SIDE_CURSORS=true


##################################################
# Redis (cache, locks, rate-limit counters)
##################################################
# Upstash → Database → the `rediss://` URL. The SAME shape in every
# environment, including development: the cache is the layer where "works
# locally" diverges most from production — TLS, an off-box round trip, dropped
# idle connections, rate limits — and none of that is exercised by a Redis in
# the next container.
#
# NOTE the missing `?ssl_cert_reqs=none`. It exists only for the self-signed
# certificate the local docker-compose Redis uses; a real Upstash certificate
# is CA-signed, and keeping the parameter would silently disable verification
# against the one endpoint where it matters.
#
# `core/adapters/redis/adapter.py` fails OPEN — an unreachable cache degrades
# to a database read rather than a 500 — which is what makes an off-box cache
# safe to depend on for reads.
REDIS_URL=rediss://default:PASSWORD@apn1-example-12345.upstash.io:6379

# Working offline, or debugging the cache without touching the shared one:
#   docker compose --profile local-redis up -d redis
#   REDIS_URL=rediss://redis:6380/0?ssl_cert_reqs=none

# "redis" everywhere including dev — caching is exercised for real, not faked.
# "locmem" is used only by the test settings.
CACHE_BACKEND=redis


##################################################
# Authentication (JWT)
##################################################
# Generate: python -c "import secrets;print(secrets.token_urlsafe(64))"
# Minimum 32 characters — HMAC-SHA256 with a key shorter than its block size is
# genuinely weakened. Production refuses to start on this shipped value: anyone
# holding this repository could otherwise mint a session for any user id.
JWT_SIGNING_KEY=dev-jwt-signing-key-change-me-0000000000

ACCESS_TOKEN_LIFETIME_MIN=15
REFRESH_TOKEN_LIFETIME_DAYS=30


##################################################
# Payments — Razorpay
##################################################
# Dashboard → Settings → API Keys → Generate. The secret is shown ONCE.
#
# ── TEST MODE IS THE PREFIX, NOT A SEPARATE SETTING ──────────────────────
#
# Razorpay encodes the mode in the key itself: `rzp_test_…` and `rzp_live_…`
# are different credentials from different halves of the dashboard, and the
# toggle at the top of it decides which pair you are shown. There is no
# `PAYMENTS_MODE` variable here on purpose — a second setting could disagree
# with the key it describes, and the disagreement would be silent.
#
# A TEST key is what development should hold. Checkout runs for real, the
# webhook signature is verified for real, and Razorpay's test cards move no
# money. `core/preflight.py` REFUSES to boot development settings against an
# `rzp_live_` key for exactly that reason, and the console's health tile prints
# the mode beside the adapter — one demo taken on live keys moves somebody's
# real money, and one launch left on test keys takes none of it. Neither
# failure announces itself.
#
# `PAYMENTS_BACKEND=fake` remains the default in development (see
# `DEV_PAYMENTS_BACKEND` in docker-compose.override.yml). Set it to `razorpay`
# with a TEST key when you want to exercise the real checkout.
#
# Razorpay's test cards: 4111 1111 1111 1111, any future expiry, any CVV.
RAZORPAY_KEY_ID=rzp_test_dummy1234567890
RAZORPAY_KEY_SECRET=dummy_rzp_secret_0000000000000000

# Dashboard → Settings → Webhooks → Add Webhook. YOU choose this value; it must
# match what you type into that form exactly. It verifies the only proof of
# payment this platform accepts, so a wrong value means no booking is ever
# confirmed — the customer pays and never gets a ticket.
#
# THE WEBHOOK URL IS NOT AN ENVIRONMENT VARIABLE, deliberately. Razorpay calls
# US, so the URL is configured in THEIR dashboard; nothing in this codebase
# reads it. (Contrast CLOUD_TASKS_TARGET_URL, which IS here because our code
# hands it to Cloud Tasks so the queue knows where to POST.) Adding it would be
# a variable nothing consumes.
#
# What to enter in the Razorpay dashboard:
#   URL     https://<your-api-host>/api/v1/payments/webhook
#   Secret  the value below, character for character
#   Events  payment.captured   → confirms the booking and issues tickets
#           payment.failed     → releases the held inventory
#
# Subscribe to those TWO only. `refund.processed` is deliberately not handled:
# refunds are initiated BY this platform (PaymentService.execute_refund) and
# recorded in the same transaction, so an inbound refund webhook would be a
# second, later source of truth for something already settled. Any other event
# type is recorded in the ProcessedWebhook ledger and ignored.
#
# LOCAL DEV: Razorpay cannot reach localhost. Until this API is on a public
# host, no webhook arrives, so a booking stays `reserved`, never becomes
# `paid`, and the sweeper expires it. To exercise the full funnel locally,
# tunnel it (`cloudflared tunnel --url http://localhost:8000`, or ngrok) and
# register that temporary URL instead.
RAZORPAY_WEBHOOK_SECRET=dummy_rzp_webhook_secret_00000000

# "fake" in dev/test — it still verifies webhook signatures for real (pure
# HMAC, no network), so the security-critical path is identical. Production
# refuses to start on it.
PAYMENTS_BACKEND=fake


##################################################
# Email (SMTP)
##################################################
# "console" logs instead of sending (dev/test). "smtp" is production.
EMAIL_PROVIDER=console

# Development ONLY: which EmailPort the docker-compose dev override selects.
# `console` (default) logs the message — including verification codes — to the
# web container's stdout. `smtp` sends for real through the SMTP_* values
# above, which is the only way to check what an email actually looks like in
# a client. Production ignores this entirely and reads EMAIL_PROVIDER.
DEV_EMAIL_PROVIDER=console

# Which payment adapter DEVELOPMENT uses (docker-compose.override.yml).
# `razorpay` with rzp_test_ keys opens Razorpay's real sandbox checkout and
# moves no real money; `fake` skips the provider entirely. Dev preflight
# refuses to boot with an rzp_live_ key whatever this says.
DEV_PAYMENTS_BACKEND=fake



SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# The envelope sender. Must be an address whose domain you control and have
# published SPF, DKIM and DMARC for — without those, ticket emails land in
# spam and the customer arrives at the gate with no QR code.
SMTP_FROM_EMAIL=

# MUTUALLY EXCLUSIVE. Port 587 = STARTTLS (SMTP_USE_TLS). Port 465 = implicit
# TLS (SMTP_USE_SSL). They are different protocols, not a strength setting;
# the adapter refuses both rather than failing on the first ticket sold.
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Without a timeout a wedged relay hangs the worker forever, so the
# notification is neither sent nor retried — it just stops.
SMTP_TIMEOUT_SECONDS=10


##################################################
# Storage
##################################################
# "local" writes to the container filesystem. "s3" is any S3-compatible
# object store. "gcs" is Google Cloud Storage.
#
# PRODUCTION MUST NOT USE "local": the container filesystem is ephemeral, so
# every uploaded poster and performer photo is LOST on the next redeploy.
# core/preflight.py refuses it.
#
# The production answer here is "s3" against SUPABASE STORAGE — the database
# is already Supabase, so it is one vendor, one bill and one region. Cloudflare
# R2, AWS S3 and MinIO all speak the same protocol and work with the same
# adapter; only S3_ENDPOINT_URL differs.
# `local` writes to the container's filesystem and is refused in production —
# uploads would vanish on the next redeploy. `s3` covers Supabase Storage,
# Cloudflare R2, Backblaze B2, MinIO and AWS S3 through one adapter.
#
# Supabase Storage note: the bucket enforces an ALLOWED MIME TYPE list. A
# PutObject with a type outside it returns HTTP 415 `InvalidMimeType`, and the
# XML body carries an empty error Code — so it surfaces as a bare 415 with no
# message. The bucket must allow every type in `core.uploads.ALLOWED_IMAGE_TYPES`
# (image/jpeg, image/png, image/webp, image/avif, image/gif).
STORAGE_BACKEND=local

# Required ONLY when STORAGE_BACKEND=s3.
#   Supabase  : Dashboard -> Storage -> S3 Connection
#               endpoint  https://<project-ref>.supabase.co/storage/v1/s3
#               region    the project region, e.g. ap-south-1
#               keys      generated on that same screen
#   R2        : https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# Where a BROWSER fetches objects — normally a CDN in front of the bucket.
# Blank falls back to the bucket endpoint, which works but pays origin egress
# on every single view. Mirror this into the frontend as
# NEXT_PUBLIC_MEDIA_BASE_URL so next/image will optimise from it.
S3_PUBLIC_BASE_URL=

# Required ONLY when STORAGE_BACKEND=gcs. Blank while GCP is unused.
GCS_BUCKET_NAME=
GCP_PROJECT_ID=

# LOCAL DEV ONLY, and only with a GCP backend selected. In production use an
# attached, least-privilege service account — never a downloaded key file.
# Read by the Google SDK from the process environment, not by Django.
GOOGLE_APPLICATION_CREDENTIALS=


##################################################
# Background Tasks
##################################################
# NOT USING GCP RIGHT NOW, so both stay on their in-process backends. Unlike
# storage, that is a legitimate production posture for a single-service
# deployment — it is slower, not broken:
#
#   QUEUE_BACKEND=local       runs each task synchronously, inside the request
#                             that enqueued it. Correct but not deferred, so a
#                             slow task makes a slow response. Preflight does
#                             NOT refuse it.
#   EVENT_BUS_BACKEND=inprocess  dispatches domain events to subscribers in the
#                             same process. The outbox still guarantees
#                             delivery, and `config/worker.py` still drains it.
#
# Whichever you choose, the SCHEDULER must still run or held inventory never
# releases and organizers are never paid:
#     python manage.py run_scheduled_jobs --once   (on a cron tick)
QUEUE_BACKEND=local
EVENT_BUS_BACKEND=inprocess

# Required ONLY when QUEUE_BACKEND=cloud_tasks.
CLOUD_TASKS_QUEUE=default-queue
CLOUD_TASKS_LOCATION=asia-south1
# THIS service's own dispatch endpoint. Cloud Tasks POSTs every task here.
# Before it existed, every enqueue succeeded and every delivery 404'd silently.
# CLOUD_TASKS_TARGET_URL=https://api.example.com/internal/tasks/run
CLOUD_TASKS_TARGET_URL=
# Optional second factor: the queue's service account, so Cloud Tasks attaches
# a Google-signed OIDC token Cloud Run can verify before Django is reached.
CLOUD_TASKS_SERVICE_ACCOUNT=

# Required ONLY when EVENT_BUS_BACKEND=pubsub.
PUBSUB_TOPIC_EVENTS=platform-events


##################################################
# Notifications
##################################################
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BACKOFF_SECONDS=30
NOTIFICATION_EVENT_REMINDER_HOURS_BEFORE=24

# The timezone every human-readable date in an outbound message is rendered in.
# SEPARATE from the database's UTC: one is how an instant is stored, the other
# is how a person reads it. The ticket PDF somebody carries to a gate must say
# the same time as the event page they bought it from.
NOTIFICATION_DISPLAY_TIMEZONE=Asia/Kolkata

# Where "something is waiting for your decision" alerts go — an event submitted
# for review, an organization asking to be verified, a performer profile in the
# queue. Comma-separated; a shared ops mailbox and three named people are both
# fine.
#
# LEAVE IT EMPTY AND NO ALERT IS SENT. That is deliberate, not a bug: there is
# no safe address to fall back on, and inventing one would route operational
# mail somewhere nobody chose. Submissions still succeed; the skip is logged.
PLATFORM_ADMIN_EMAILS=

# The FRONTEND's public origin, used to build deep links that leave the backend
# (a push notification's tap target). Blank means "omit the link" rather than
# "guess" — a notification pointing at the wrong host is worse than one with
# no link at all.
PUBLIC_SITE_URL=http://localhost:3000


##################################################
# Web Push (VAPID)
##################################################
# SELF-GENERATED — there is no vendor account and nothing to pay for:
#     python manage.py generate_vapid_keys --env
# Needs the extra: pip install -e ".[push]"
#
# All blank (the default) means push is OFF, and the platform says so rather
# than pretending: the port reports itself unconfigured, the subscribe endpoint
# returns 422, and the UI renders nothing instead of asking for a browser
# permission it could never honour.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: or https URL a push service can reach you at. REQUIRED by the VAPID
# spec — Firefox rejects tokens without it.
VAPID_CONTACT=

PUSH_BACKEND=webpush


##################################################
# Sentry
##################################################
# THIS IS THE BACKEND DSN ONLY. Sentry issues a separate DSN per project, and
# a Django project and a Next.js project are two projects — putting the same
# DSN in both merges server and browser errors into one stream where you can
# no longer tell which side broke. The FRONTEND DSN goes in
# frontend/.env.local as NEXT_PUBLIC_SENTRY_DSN.
#
# Sentry → your Django project → Settings → Client Keys (DSN).
#
# WORKS AS SOON AS YOU SET IT — but it needs the optional package, or the app
# logs "SENTRY_DSN is set but sentry-sdk is not installed" and carries on:
#     pip install -e ".[observability]"
#
# Unset = exceptions are still logged as structured JSON; only the alerting is
# missing. PII is scrubbed either way (backend/core/observability.py):
# no request bodies, no cookies, and headers matching authorization / token /
# secret / signature are redacted.
SENTRY_DSN=

# 0.0–1.0. Performance tracing samples a fraction of requests and is billed
# separately from errors. Leave at 0 unless you are actively investigating
# latency; 0.1 is a sane starting point if you are.
SENTRY_TRACES_SAMPLE_RATE=0.0

# Set per deploy (e.g. the git SHA) so a stack trace maps to a commit.
# Without it every error is attributed to "unknown release".
SENTRY_RELEASE=


##################################################
# Security
##################################################
# Generate: python -c "import secrets;print(secrets.token_urlsafe(64))"
# Minimum 32 characters. Signs the QR on every ticket; production refuses to
# start on this shipped value, because anyone holding this repository could
# otherwise forge a ticket that passes the gate scanner.
# ROTATING THIS INVALIDATES EVERY TICKET ALREADY ISSUED.
TICKET_QR_SIGNING_KEY=dev-qr-signing-key-change-me-000000000000

# Proves a task-dispatch request really came from our queue. Required when
# QUEUE_BACKEND=cloud_tasks — the endpoint runs registered task handlers, one
# of which releases a payout, so an unauthenticated one is a URL anyone on the
# internet can use to move money.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
INTERNAL_TASK_SECRET=

# Browser origins allowed to call this API. Comma-separated, scheme included.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Only /admin/ and the browsable schema use cookie auth and therefore CSRF —
# the API is Bearer-token authenticated, so no cookie authorises it.
# Staging/production only.
CSRF_TRUSTED_ORIGINS=

# Number of proxies that PREPEND to X-Forwarded-For in front of this app
# (a CDN plus a load balancer is 2; 0 trusts REMOTE_ADDR only). Rate limits are
# keyed on client IP, so too small a number trusts a client-supplied header and
# lets anyone rotate their own limit key; too large keys every request on the
# proxy's IP, turning a per-client limit into one global bucket.
NUM_PROXIES=0

# DRF throttle rates, backed by the same Redis as CACHE_BACKEND so a limit
# holds across every replica rather than per-process. Defaults live in
# backend/config/settings/base.py; set these only to tune.
# THROTTLE_ANON=120/min
# THROTTLE_USER=600/min
# THROTTLE_AUTH=10/min        sign-in / register / refresh, IP-keyed
# THROTTLE_OTP=5/hour         each request sends a paid SMS
# THROTTLE_WEBHOOK=600/min    deliberately ABOVE Razorpay's retry schedule
# THROTTLE_CHECKIN=1200/min   a gate scans fast; denying a real scan is worse
# THROTTLE_UPLOAD=60/hour
# THROTTLE_WRITE=120/min
# THROTTLE_MAPS=120/min      every Maps call is BILLED by Google, so this
#                            is a spend limit as much as an abuse control


##################################################
# Business Configuration
##################################################
# Commercial decisions, not infrastructure defaults to accept silently. Every
# one is read by code and changes what customers experience.

# How long a reservation is held awaiting payment before the sweeper releases
# it. Short, so unpaid holds do not starve inventory during an on-sale.
BOOKING_HOLD_MINUTES=10

# How long a PAID booking keeps answering to its Idempotency-Key.
#
# The checkout derives that key from the ORDER, so "two General tickets for this
# event" is always the same string. Unbounded, a paid booking answered for it
# for ever and the same selection could never be bought twice: the replay handed
# back the settled booking, the checkout showed its stale total, and Pay opened a
# provider order that had already been captured.
#
# Idempotency protects a retry of ONE request — a double-tap, a dropped
# connection, a reload mid-submit — and all of those arrive within seconds. A
# deliberate second purchase is a different intent, and elapsed time is the only
# thing that can tell them apart. Longer than any real retry, far shorter than
# "somebody decided to buy more tickets".
BOOKING_IDEMPOTENCY_REPLAY_MINUTES=15

# Payment reconciliation (payments.reconcile_pending) — the job that asks the
# provider "was this booking's order actually paid?", so a captured payment is
# fulfilled even if no webhook and no browser call ever arrived.
#
# How old a booking must be before the job asks about it. The browser's own
# verify call fires within a second of payment; asking sooner is a provider
# call spent racing it.
PAYMENT_RECONCILE_MIN_AGE_SECONDS=90
# How long after a hold lapsed the platform keeps asking. A captured payment
# found in this window is REFUNDED (the seats are gone) — without it, "paid,
# no ticket, no refund" is permanent. Bounded because every abandoned checkout
# leaves an order id behind forever.
PAYMENT_RECONCILE_GRACE_MINUTES=180

# The platform's fee per ticket, in MINOR units (paise). Taken OUT of the
# total — never added on top — so the organizer receives (total − fee).
# Platform fee in BASIS POINTS of the ticket subtotal (100 = 1%), ADDED to
# what the customer pays. Replaces the old flat PLATFORM_FEE_PER_TICKET,
# which was deducted from the organizer's share instead.
PLATFORM_FEE_BPS=100
# Ceiling on a single donation, in paise. The amount comes from the client,
# so this is what stops a checkout chip becoming an arbitrary charge.
DONATION_MAX_MINOR=100000

# An organizer payout releases only once the event has ENDED and this window
# has passed, so `net` is final and there is nothing to claw back.
SETTLEMENT_REFUND_WINDOW_HOURS=48
SETTLEMENT_MAX_ATTEMPTS=5
SETTLEMENT_RETRY_BACKOFF_SECONDS=60

# The gate scan window: a ticket may be scanned from this many minutes BEFORE
# the event starts until this many minutes after it ends.
CHECKIN_WINDOW_OPENS_BEFORE_MINUTES=180
CHECKIN_WINDOW_GRACE_AFTER_MINUTES=360


##################################################
# SMS — FUTURE INTEGRATION
##################################################
# The adapter and every message template are BUILT and tested; what is missing
# is a contracted provider and India DLT registration. `console` logs instead
# of sending, so nothing here is faked — an SMS simply does not go out.
#
# DLT registration (Jio/Airtel/Vodafone portal) takes days to weeks and
# approves a DISTINCT template per message type. Start it well before you need
# it. Provider: MSG91 / Twilio / Gupshup.
SMS_PROVIDER=console
SMS_API_KEY=
SMS_API_BASE_URL=
# 6-character DLT-approved sender header.
SMS_SENDER_ID=
SMS_DLT_ENTITY_ID=
SMS_DLT_TEMPLATE_ID=
# Per-type overrides: "otp=tmpl_a,booking_confirmation_sms=tmpl_b"
NOTIFICATION_SMS_DLT_TEMPLATE_IDS=


##################################################
# Google Maps Platform
##################################################
# ONE key for every Maps service. That is Google's own model — a key is
# enabled per-API in the Cloud console — and one key means one quota, one
# bill and one rotation. Do NOT create a second key per service.
#
# Google Cloud Console → APIs & Services → Credentials → Create credentials →
# API key. Then enable, on that key:
#     Places API  ·  Geocoding API  ·  Directions API
#     Distance Matrix API  ·  Maps JavaScript API
#
# Restrict it in the console:
#   - Application restriction: HTTP referrers for the browser key, or
#     IP addresses for a server-only key.
#   - API restriction: exactly the five above. An unrestricted key is a
#     billable credential anyone who finds it can spend.
#
# BLANK DISABLES MAPS HONESTLY: the port reports itself unconfigured, every
# /maps/ endpoint answers 503, and the UI shows the address plus a plain
# directions link rather than an empty grey map frame.
GOOGLE_MAPS_API_KEY=

# Biases geocoding and autocomplete toward one country (ccTLD, lowercase).
# `in` for India. Blank means worldwide, which for an Indian venue search
# returns a lot of Springfields.
GOOGLE_MAPS_REGION=in

# The BROWSER needs its own copy for the Maps JavaScript API, which cannot
# run server-side. Same key VALUE is fine — restrict it by HTTP referrer in
# the console. It lives in frontend/.env.local as
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY, and is public by necessity: anything the
# browser uses is in the page source.


##################################################
# Google OAuth (Calendar)
##################################################
# ONE OAuth client for every Google feature. Calendar asks for its own scopes
# on top; a second client would mean a second consent screen and a second
# verification review for the same application.
#
# Google Cloud Console → APIs & Services → Credentials → Create credentials →
# OAuth client ID → Web application. Also enable the **Google Calendar API**
# on the project, or the token exchange succeeds and every calendar write 403s.
#
# Scopes requested (and only these):
#     https://www.googleapis.com/auth/calendar.events   create/update/delete
#     openid, email                                     name the connected account
# NOT the broader `calendar` scope, which also permits deleting entire
# calendars — a permission this feature never needs and which makes Google's
# consent screen far more alarming.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Must be registered VERBATIM as an Authorized redirect URI in that console,
# or Google refuses the callback with redirect_uri_mismatch. It points at THIS
# API, not at the frontend — the backend completes the exchange and then
# redirects the browser on to PUBLIC_SITE_URL.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback

# Sign in with Google returns to its OWN callback, because that callback mints
# an Eventful session rather than storing a calendar grant. SAME OAuth client
# (Google issues one per application) — a client may register many redirect
# URIs, and BOTH must be listed verbatim in the console.
#
# Blank disables Google sign-in honestly: GET /auth/oauth/google/config
# reports it unavailable and the UI hides the button.
GOOGLE_OAUTH_SIGNIN_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/signin/callback
#
# Blank disables Calendar honestly: the port reports itself unconfigured, the
# connect endpoint answers 503, and the UI does not offer the button.
#
# NOTE: Google sign-in (using these same credentials to AUTHENTICATE) is still
# not built — see REAL_INTEGRATIONS_AUDIT.md R1. Calendar connection is a
# separate, additive grant on top of an already-signed-in Eventful account.
#
# There is deliberately no GOOGLE_OAUTH_ALLOWED_ORIGINS: Google's "Authorized
# JavaScript origins" is configured in their console, not read by this
# application, and browser access is governed by CORS_ALLOWED_ORIGINS.

# =============================================================================
# WEB SERVER (gunicorn) — production process tuning
# =============================================================================
# Read by backend/docker/gunicorn.conf.py, NOT by Django. Every one has a
# working default; they exist so a process can be tuned without a rebuild.

# The port gunicorn binds. Compose maps it; change both or neither.
PORT=8000

# Worker processes. Each holds its own database connections, so this is
# BOUNDED BY THE POOLER, not by CPU: Supabase's transaction pooler allows a
# limited number of client connections, and the scheduler and outbox worker
# draw from the same limit. Exhausting it presents as a database outage.
#
# Blank = (2*CPU)+1 capped at 9. An explicit value is HONOURED — silently
# discarding what an operator set is the failure mode this whole configuration
# exists to remove — but anything above 9 prints a warning naming the risk.
WEB_CONCURRENCY=

# Threads per worker. Above 1 makes each worker handle concurrent requests
# while one waits on Postgres or Razorpay — which is what this workload is
# mostly doing.
WEB_THREADS=2

# Seconds before gunicorn kills a worker it considers hung. Above the slowest
# legitimate request (a Razorpay call inside a checkout), below any upstream
# proxy timeout.
WEB_TIMEOUT=60

# Seconds a worker gets to finish in-flight requests after SIGTERM. MUST stay
# below `stop_grace_period` in docker-compose.yml (40s) or Docker kills the
# worker before it finishes — mid-deploy, that can land between recording a
# payment and issuing the ticket.
WEB_GRACEFUL_TIMEOUT=30

# gunicorn's own log level. The application's logging is configured in
# config/settings/base.py and is unaffected by this.
GUNICORN_LOG_LEVEL=info

# Which peers gunicorn will believe X-Forwarded-* headers from. Defaults to
# the private ranges, deliberately NOT `*`: trusting every peer lets a client
# that can reach the container directly forge its own source IP and defeat
# every IP-keyed rate limit. Set to your proxy's address if it is elsewhere.
FORWARDED_ALLOW_IPS=

# =============================================================================
# TEST SAFETY
# =============================================================================
# pytest CREATES AND DROPS its database. config/settings/test.py therefore
# refuses to run against a host that is not local — the production readiness
# audit found DIRECT_DATABASE_URL resolving to production Supabase, which
# would have dropped a database there.
#
# Leave this blank. Set it to true ONLY to run the suite against a remote
# database you are certain is disposable.
ALLOW_REMOTE_TEST_DATABASE=


##################################################
# Deployment topology (docker-compose + Caddy)
##################################################
# These are read by the compose files and the reverse proxy rather than by
# Django, but they belong here: the contract test requires .env and this file
# to declare the same set, and a deploy variable that exists only in somebody's
# private .env is one nobody else can reproduce the environment from.

# The public hostname Caddy serves, and the address it registers a TLS
# certificate against.
SITE_DOMAIN=localhost
ACME_EMAIL=admin@example.com

# Where Caddy sends non-API traffic — the Next.js container.
FRONTEND_UPSTREAM=frontend:3000
# The port gunicorn binds inside the web container.
WEB_PORT=8000

# The bundled Postgres container's own credentials. Distinct from DATABASE_URL,
# which is what the APP connects with — in production that points at a managed
# instance and these are unused.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=eventsdb

# Frontend build-time values. They are NEXT_PUBLIC_, so they are inlined into
# the browser bundle — never put a secret in one. They live here because the
# frontend image is built by the same compose file.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MEDIA_BASE_URL=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

##################################################
# Rate limits
##################################################
# Read by core/throttling.py. They FAIL OPEN if Redis is down — a shut door at
# a venue is worse than a window of unmetered requests, and the correctness
# guards (signature verification, row locks) never depended on them.
#
# `checkin` is deliberately the loosest: a gate scans continuously during entry
# and denying a real scan means a queue at a door.
THROTTLE_ANON=120/min
THROTTLE_USER=240/min
THROTTLE_AUTH=10/min
# PER HOUR, not per minute. Every OTP request sends a real SMS that costs
# real money, so this is a spend limit as much as a security control — and
# `5/min` is a 60x looser ceiling on the one endpoint on the platform that
# bills per call. It contradicted the reference block above, the code default
# in `config/settings/base.py`, and `test_otp_is_tighter_than_general_auth`,
# which asserts `/hour` for exactly this reason. The test only ever ran with
# no repo `.env` present, so the code default masked it.
THROTTLE_OTP=5/hour
THROTTLE_WRITE=60/min
THROTTLE_UPLOAD=20/min
THROTTLE_CHECKIN=600/min
THROTTLE_WEBHOOK=300/min
THROTTLE_MAPS=60/min
