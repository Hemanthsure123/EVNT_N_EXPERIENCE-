# =============================================================================
# Eventful — STAGING environment template
# =============================================================================
# Copy to `.env` ON THE STAGING HOST and fill in every <PLACEHOLDER>.
#
#     cp .env.staging.example .env && ${EDITOR:-vi} .env
#
# CONTAINS NO SECRETS. Every credential below is a placeholder.
#
# ── WHAT STAGING IS FOR, AND WHY ITS GATE IS DIFFERENT ──────────────────────
#
# `config/settings/staging.py` runs the SAME preflight as production with
# `strict=False`. Two deliberate differences:
#
#   1. A fake adapter is a WARNING, not a refusal. Exercising the booking
#      funnel end to end without moving real money is precisely what staging
#      is for, so `PAYMENTS_BACKEND=fake` is a legitimate choice here and a
#      refusal in production.
#   2. The public-URL checks are skipped. Staging legitimately runs on
#      internal hostnames.
#
# Everything about SECRETS stays fatal. The moment one real person signs in,
# staging holds real credentials — and the signing keys shipped in
# `.env.example` would let anyone with this repository forge their session.
#
# ── STAGING MUST NOT SHARE PRODUCTION'S RESOURCES ───────────────────────────
#
# Its own Supabase project, its own Redis, its own bucket. Not a schema or a
# key prefix inside production's — a staging bug that deletes rows must not be
# able to reach a real booking.
#
# All four env templates declare the SAME variable set; the contract test
# fails if they drift. See `.env.example` for the full explanation of each
# variable and `ENVIRONMENT_VARIABLES.md` for the table.
# =============================================================================


##################################################
# Django core
##################################################
ENVIRONMENT=staging
DJANGO_SETTINGS_MODULE=config.settings.staging
DEBUG=false

# Generate three DISTINCT values, each >= 32 bytes, and DIFFERENT from
# production's — a staging leak must not be a production compromise:
#     python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=<GENERATE-64-BYTE-RANDOM-STRING>

ALLOWED_HOSTS=api.staging.<YOUR-DOMAIN>
ENABLE_SILK=false


##################################################
# Database — a SEPARATE Supabase project
##################################################
DATABASE_URL=postgresql://postgres.<STAGING-PROJECT-REF>:<DB-PASSWORD>@aws-1-<REGION>.pooler.supabase.com:6543/postgres?sslmode=require
DIRECT_DATABASE_URL=postgresql://postgres.<STAGING-PROJECT-REF>:<DB-PASSWORD>@aws-1-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require
CONN_MAX_AGE=0
DISABLE_SERVER_SIDE_CURSORS=true


##################################################
# Redis — a SEPARATE Upstash database
##################################################
REDIS_URL=rediss://default:<UPSTASH-TOKEN>@<STAGING-ENDPOINT>.upstash.io:6379
CACHE_BACKEND=redis


##################################################
# Authentication
##################################################
JWT_SIGNING_KEY=<GENERATE-64-BYTE-RANDOM-STRING>
ACCESS_TOKEN_LIFETIME_MIN=30
REFRESH_TOKEN_LIFETIME_DAYS=14


##################################################
# Payments
##################################################
# Two supported choices, both correct for staging:
#
#   PAYMENTS_BACKEND=fake      no vendor account needed. The fake adapter
#                              still verifies webhook signatures with REAL
#                              HMAC, so the security-critical path is
#                              identical to production. Preflight warns.
#   PAYMENTS_BACKEND=razorpay  with rzp_test_ keys, to exercise the real
#                              vendor round trip including the webhook.
#
# NEVER `rzp_live_` here. A staging checkout must not move real money.
PAYMENTS_BACKEND=fake
RAZORPAY_KEY_ID=rzp_test_<TEST-KEY-ID>
RAZORPAY_KEY_SECRET=<TEST-KEY-SECRET>
# Required even with the fake adapter — it performs real HMAC verification.
RAZORPAY_WEBHOOK_SECRET=<ANY-RANDOM-STRING-FOR-STAGING>

# Development ONLY — the docker-compose dev override reads this to pick its
# PaymentPort. It has NO effect here: staging and production read
# PAYMENTS_BACKEND above. Declared (commented) for the same reason
# DEV_EMAIL_PROVIDER is: every template holds the same variable set, which is
# what stops one file silently omitting a value nobody chose.
# DEV_PAYMENTS_BACKEND=fake


##################################################
# Email
##################################################
# `console` prints the message instead of sending it. Prefer it unless you are
# specifically testing deliverability — staging data contains real addresses
# once anybody signs in, and a test run should not email them.
EMAIL_PROVIDER=console

# Development ONLY — the docker-compose dev override reads this to pick its
# EmailPort. It has NO effect here: staging and production read EMAIL_PROVIDER
# above. Declared (commented) so every template holds the same variable set,
# which is what stops one file silently omitting a value nobody chose.
# DEV_EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=tickets@staging.<YOUR-DOMAIN>
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10


##################################################
# Object storage — a SEPARATE bucket
##################################################
# `local` is permitted here (a warning, not a refusal), but uploads still
# vanish on redeploy — which makes any test of the media path meaningless.
# Use a real staging bucket.
STORAGE_BACKEND=s3
S3_BUCKET_NAME=<STAGING-BUCKET-NAME>
S3_ENDPOINT_URL=https://<STAGING-PROJECT-REF>.supabase.co/storage/v1/s3
S3_ACCESS_KEY_ID=<S3-ACCESS-KEY-ID>
S3_SECRET_ACCESS_KEY=<S3-SECRET-ACCESS-KEY>
S3_REGION=<REGION>
S3_PUBLIC_BASE_URL=https://<STAGING-PROJECT-REF>.supabase.co/storage/v1/object/public/<STAGING-BUCKET-NAME>

GCS_BUCKET_NAME=
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=


##################################################
# Background work
##################################################
QUEUE_BACKEND=local
EVENT_BUS_BACKEND=inprocess
CLOUD_TASKS_QUEUE=
CLOUD_TASKS_LOCATION=
CLOUD_TASKS_TARGET_URL=
CLOUD_TASKS_SERVICE_ACCOUNT=
PUBSUB_TOPIC_EVENTS=
INTERNAL_TASK_SECRET=


##################################################
# Notifications
##################################################
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BACKOFF_SECONDS=30
# Shorter than production, so a reminder can be observed within a test session
# rather than a day later.
NOTIFICATION_EVENT_REMINDER_HOURS_BEFORE=1

# The timezone every human-readable date in an outbound message is rendered in.
# SEPARATE from the database's UTC: one is how an instant is stored, the other
# is how a person reads it.
NOTIFICATION_DISPLAY_TIMEZONE=Asia/Kolkata

# Where "something is waiting for your decision" alerts go — an event submitted
# for review, an organization asking to be verified, a performer profile in the
# queue. Comma-separated.
#
# Worth setting on staging even though it is not production: this is the only
# way to see that the approval queue actually notifies anybody BEFORE the
# configuration that matters is the live one. Empty sends no alert and logs
# the skip.
PLATFORM_ADMIN_EMAILS=


##################################################
# Public URLs
##################################################
# Preflight does NOT enforce https or reject localhost here — staging runs on
# internal hostnames legitimately. Use real staging hostnames anyway: OAuth
# and CORS both fail in confusing ways otherwise.
PUBLIC_SITE_URL=https://staging.<YOUR-DOMAIN>
CORS_ALLOWED_ORIGINS=https://staging.<YOUR-DOMAIN>
CSRF_TRUSTED_ORIGINS=https://api.staging.<YOUR-DOMAIN>
NUM_PROXIES=1


##################################################
# Web Push (VAPID)
##################################################
# Generate a SEPARATE pair (`python manage.py generate_vapid_keys`).
# Browsers key a subscription to the application server's public key, so
# reusing production's would let staging push to production subscribers.
VAPID_PUBLIC_KEY=<STAGING-VAPID-PUBLIC-KEY>
VAPID_PRIVATE_KEY=<STAGING-VAPID-PRIVATE-KEY>
VAPID_CONTACT=mailto:ops@<YOUR-DOMAIN>
PUSH_BACKEND=webpush


##################################################
# Observability — Sentry
##################################################
# The same project as production is fine — `ENVIRONMENT=staging` above is what
# separates the two streams, and one project means one alerting configuration.
SENTRY_DSN=<BACKEND-SENTRY-DSN>
# Higher than production: staging traffic is tiny, so full-rate tracing costs
# nothing and makes a slow endpoint visible before it ships.
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_RELEASE=<GIT-SHA>


##################################################
# Tickets
##################################################
# A DIFFERENT key from production. A ticket minted in staging must never
# validate at a real gate.
TICKET_QR_SIGNING_KEY=<GENERATE-64-BYTE-RANDOM-STRING>


##################################################
# Rate limits
##################################################
# Commented out = the code's defaults apply, which is what you want staging to
# exercise. Raising them here means production's limits are never tested.
# THROTTLE_ANON=120/min
# THROTTLE_USER=600/min
# THROTTLE_AUTH=10/min
# THROTTLE_OTP=5/min
# THROTTLE_WEBHOOK=300/min
# THROTTLE_CHECKIN=600/min
# THROTTLE_UPLOAD=30/min
# THROTTLE_WRITE=120/min
# THROTTLE_MAPS=60/min


##################################################
# Business rules
##################################################
# Mirror production, EXCEPT the two windows shortened so a full lifecycle
# (hold expiry, settlement release) can be observed in one sitting instead of
# over two days. Any other divergence means staging stops predicting
# production.
BOOKING_HOLD_MINUTES=5

# How long a PAID booking keeps answering to its Idempotency-Key. The checkout
# derives that key from the ORDER, so unbounded it made a selection permanently
# unbuyable once bought: the replay returned the settled booking and Pay opened a
# provider order that had already been captured. Long enough for any real retry
# (a double-tap, a dropped connection), far shorter than a second purchase.
BOOKING_IDEMPOTENCY_REPLAY_MINUTES=15
# Payment reconciliation (payments.reconcile_pending): the backstop that asks
# the provider whether a booking's order was actually paid, so a captured
# payment is fulfilled — or refunded — even if no webhook and no browser call
# ever arrived. MIN_AGE keeps it from racing the browser's own verify call;
# GRACE bounds how long after a lapsed hold the platform keeps asking.
PAYMENT_RECONCILE_MIN_AGE_SECONDS=90
PAYMENT_RECONCILE_GRACE_MINUTES=180
# Platform fee in BASIS POINTS of the ticket subtotal (100 = 1%), ADDED to
# what the customer pays — review this before launch; it is a business
# decision, not a default to accept.
PLATFORM_FEE_BPS=100
# Ceiling on a single donation, in paise.
DONATION_MAX_MINOR=100000
SETTLEMENT_REFUND_WINDOW_HOURS=1
SETTLEMENT_MAX_ATTEMPTS=5
SETTLEMENT_RETRY_BACKOFF_SECONDS=60
CHECKIN_WINDOW_OPENS_BEFORE_MINUTES=120
CHECKIN_WINDOW_GRACE_AFTER_MINUTES=120


##################################################
# SMS
##################################################
SMS_PROVIDER=console
SMS_API_KEY=
SMS_API_BASE_URL=
SMS_SENDER_ID=
SMS_DLT_ENTITY_ID=
SMS_DLT_TEMPLATE_ID=
NOTIFICATION_SMS_DLT_TEMPLATE_IDS=


##################################################
# Google Maps Platform
##################################################
# A SEPARATE, restricted key. Sharing production's means staging traffic bills
# production's quota, and a staging leak forces a production key rotation.
GOOGLE_MAPS_API_KEY=<STAGING-GOOGLE-MAPS-SERVER-KEY>
GOOGLE_MAPS_REGION=in


##################################################
# Google OAuth — Calendar
##################################################
# The SAME OAuth client as production is fine and usually preferable — Google
# issues one per application, and a second means a second consent screen and a
# second verification review. Add the staging callback below to that client's
# Authorized redirect URIs alongside production's.
GOOGLE_OAUTH_CLIENT_ID=<OAUTH-CLIENT-ID>.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=<OAUTH-CLIENT-SECRET>
GOOGLE_OAUTH_REDIRECT_URI=https://api.staging.<YOUR-DOMAIN>/api/v1/auth/oauth/google/callback

# Sign-in's own callback. Same OAuth client as calendar; register BOTH URIs
# verbatim in the Google console.
GOOGLE_OAUTH_SIGNIN_REDIRECT_URI=https://api.staging.<YOUR-DOMAIN>/api/v1/auth/oauth/google/signin/callback


##################################################
# Web server (gunicorn)
##################################################
PORT=8000
# Staging serves one tester, not a launch. Two workers is enough, and it
# leaves the pooler's connection budget for the real thing.
WEB_CONCURRENCY=2
WEB_THREADS=2
WEB_TIMEOUT=60
WEB_GRACEFUL_TIMEOUT=30
GUNICORN_LOG_LEVEL=info
FORWARDED_ALLOW_IPS=


##################################################
# Test safety
##################################################
# LEAVE BLANK. Even in staging: pytest CREATES AND DROPS its database, and
# staging holds real sign-ups.
ALLOW_REMOTE_TEST_DATABASE=


##################################################
# Deployment topology (docker-compose + Caddy)
##################################################
# Read by the compose files and the reverse proxy rather than by Django. They
# belong in every template because a deploy variable that exists only in one
# environment's private file is one nobody can reproduce the others from --
# the same failure the .env/.env.example parity check exists to catch.

# The public hostname Caddy serves and registers a TLS certificate for.
SITE_DOMAIN=<YOUR-DOMAIN>
ACME_EMAIL=<ops@YOUR-DOMAIN>

# Where Caddy sends non-API traffic, and the port gunicorn binds in-container.
FRONTEND_UPSTREAM=frontend:3000
WEB_PORT=8000

# The BUNDLED Postgres container's own credentials. Distinct from DATABASE_URL,
# which is what the app connects with -- in production that points at a managed
# instance and these go unused.
POSTGRES_USER=app
POSTGRES_PASSWORD=<STRONG-LOCAL-PASSWORD>
POSTGRES_DB=eventsdb

# Frontend build args, passed into the Next.js image build. They are
# NEXT_PUBLIC_, so they are inlined into the browser bundle -- never put a
# secret in one.
NEXT_PUBLIC_API_BASE_URL=https://<YOUR-DOMAIN>
NEXT_PUBLIC_SITE_URL=https://<YOUR-DOMAIN>
NEXT_PUBLIC_MEDIA_BASE_URL=<YOUR-STORAGE-HOST>
NEXT_PUBLIC_RAZORPAY_KEY_ID=<RAZORPAY-KEY-ID>
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=<BROWSER-RESTRICTED-MAPS-KEY>
